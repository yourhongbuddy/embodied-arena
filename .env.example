# Server-only. No NEXT_PUBLIC/VITE-prefixed secrets.
HILO_PUBLIC_URL=http://localhost:5173
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Local test database; create it with npm run db:intake:local.
HILO_SQLITE_PATH=work/hilo-intake.sqlite
# Node production may use the existing D1 database over HTTPS instead of SQLite.
# Omit HILO_SQLITE_PATH when using remote D1.
CLOUDFLARE_ACCOUNT_ID=
HILO_D1_DATABASE_ID=
HILO_D1_API_TOKEN=
