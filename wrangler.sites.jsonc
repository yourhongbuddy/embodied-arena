{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "embodied-arena",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  }
}
