// Synthetic local test runtime only. Never deploy this configuration.
{
  "name": "arena-account-local-test",
  "main": "../dist/server/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "assets": { "directory": "../dist/client", "binding": "ASSETS", "not_found_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "arena-account-local-test", "database_id": "arena-account-local-test" }]
}
